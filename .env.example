# Copy this file to .env (or export these as real environment variables)
# and fill in real values before deploying. The project runs fine with
# NONE of these set -- it just uses SQLite and demo/test payment modes.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- Database -----------------------------------------------------------
# Leave USE_MYSQL unset (or False) to keep using SQLite (db.sqlite3).
USE_MYSQL=False
DB_NAME=smart_parking_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Google Maps ----------------------------------------------------------
# Not required: lot detail pages already embed Google Maps without a key.
# Set this only if you upgrade to the JS Maps API for interactive markers.
GOOGLE_MAPS_API_KEY=

# --- eSewa (ePay v2) ------------------------------------------------------
# EPAYTEST is eSewa's public UAT merchant code and works out of the box
# against https://rc-epay.esewa.com.np (test credentials: eSewa ID 9806800001..9806800005,
# password Nepal@123, MPIN 1122, token 123456).
ESEWA_MERCHANT_CODE=EPAYTEST

# --- Khalti (KPG-2) ---------------------------------------------------------
# Leave blank to run Khalti in demo/simulated mode. Add your test secret
# key from https://test-admin.khalti.com to enable real Khalti checkout.
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
